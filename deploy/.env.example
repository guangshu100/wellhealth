# ============================================================
# WellHealth 部署环境变量模板
# 复制为 deploy/.env 后按需修改：cp deploy/.env.example deploy/.env
# 这些变量用于覆盖 backend/.env 中的中间件连接地址（容器内无法访问宿主 localhost）。
# ============================================================

# 如果中间件运行在宿主机，使用默认 host.docker.internal 即可，无需修改。
# 若为远程服务器或独立容器，改为对应 IP：192.168.1.10 等。

# MySQL
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306

# Redis
REDIS_HOST=host.docker.internal
REDIS_PORT=6379

# Neo4j（完整 URI）
NEO4J_URI=bolt://host.docker.internal:7687

# Qdrant
QDRANT_HOST=host.docker.internal
QDRANT_PORT=6333

# 本地 Ollama（启用 compose `--profile ollama` 内置服务时改为 http://ollama:11434）
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 对外端口
BACKEND_PORT=8000
FRONTEND_PORT=3000