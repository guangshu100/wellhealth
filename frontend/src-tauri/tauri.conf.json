{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "康伴健康",
  "version": "1.0.0",
  "identifier": "com.wellhealth.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "康伴健康 - 慢病管理AI平台",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "http": {
      "enabled": true,
      "scope": ["http://localhost:8000/*", "https://*/*"]
    },
    "fs": {
      "enabled": true,
      "scope": ["$APPDATA/**", "$APPCONFIG/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$PICTURE/**"]
    },
    "notification": {
      "enabled": true
    },
    "dialog": {
      "enabled": true
    },
    "os": {
      "enabled": true
    }
  }
}
